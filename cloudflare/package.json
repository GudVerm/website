{
  "name": "gudelius-cms",
  "private": true,
  "version": "0.4.7",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute gudelius-cms-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute gudelius-cms-db --remote --file=./schema.sql",
    "check": "node --check src/index.js && node --check smoke-test.mjs",
    "deploy:dry": "wrangler deploy --dry-run",
    "smoke:remote": "node smoke-test.mjs",
    "media:audit": "node media-audit.mjs",
    "media:cleanup": "node media-cleanup.mjs",
    "images:migrate-wix": "node migrate-wix-images.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  },
  "type": "module"
}
