{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gudelius-cms",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://gudverm.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gudelius-cms-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "gudelius-media"
    }
  ]
}
