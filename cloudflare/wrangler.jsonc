{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gudelius-cms",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://gudverm.github.io",
    "CONTACT_EMAIL_FROM": "website@gudeliusvermessung.de"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gudelius-cms-db",
      "database_id": "7942d0c3-e587-4b61-8bc7-6f9b3b8d1029"
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "gudeliusvermessung@web.de"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "gudelius-media"
    }
  ]
}
