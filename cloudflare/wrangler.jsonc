{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gudelius-cms",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://gudverm.github.io",
    "BREVO_FROM_EMAIL": "gudeliusvermessung@web.de",
    "BREVO_FROM_NAME": "GudeliusVermessung",
    "CONTACT_EMAIL_TO": "gudeliusvermessung@web.de",
    "PUBLIC_MEDIA_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gudelius-cms-db",
      "database_id": "7942d0c3-e587-4b61-8bc7-6f9b3b8d1029"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "gudelius-media"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2026092401",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "2026092402",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "MEDIA_RATE_LIMITER",
      "namespace_id": "2026092403",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
